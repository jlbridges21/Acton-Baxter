# Core
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APP_BASE_URL=http://localhost:3000

# Research mode
ENABLE_MOCK_RESEARCH=true
ALLOW_MOCK_FALLBACK=false
ATTOM_API_KEY=
RENTCAST_API_KEY=
ATTOM_BASE_URL=https://api.gateway.attomdata.com/propertyapi/v1.0.0
RENTCAST_BASE_URL=https://api.rentcast.io/v1
EXTERNAL_API_TIMEOUT_MS=12000
EXTERNAL_API_MAX_RETRIES=2

# Address autocomplete + report imagery (recommended for production)
# Enable Places, Geocoding, Maps Static, and Street View Static APIs.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
# Legacy alias still accepted:
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# AI — Property Research report generation only (not Baxter chat)
AI_PROVIDER=deterministic
# Optional alias (overrides AI_PROVIDER when set):
# PROPERTY_RESEARCH_AI_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Baxter chat reasoning
BAXTER_CHAT_ENABLED=true
BAXTER_LLM_PROVIDER=openai
BAXTER_LLM_FALLBACK_PROVIDER=anthropic
# Preferred Baxter Q&A model (web + Slack). Independent from PEM_NEAT_OPENAI_MODEL.
# GPT-5.x uses Responses API (max_output_tokens). GPT-4o uses Chat Completions (max_tokens).
BAXTER_CHAT_MODEL=gpt-5.6-terra
# Legacy alias still honored when BAXTER_CHAT_MODEL is unset.
BAXTER_OPENAI_MODEL=gpt-5.6-luna
# Optional reasoning effort for GPT-5-class Baxter chat (none|low|medium|high|xhigh)
# BAXTER_REASONING_EFFORT=low
# PEM NEAT analysis model (independent from Baxter chat above).
# GPT-5.x uses the Responses API + reasoning; GPT-4o uses Chat Completions.
PEM_NEAT_OPENAI_MODEL=gpt-5.6-terra
# Reasoning effort for GPT-5-class PEM models: none | low | medium | high | xhigh
# Pipeline stages may override (fact ledger / assessment / review use high).
PEM_NEAT_REASONING_EFFORT=high
# Per-stage OpenAI timeout (ms). Generation is async/durable; stages may take several minutes.
# PEM_NEAT_TIMEOUT_MS=180000
# Optional technical fallback only (rate limit / 5xx / model unavailable / timeout). Not used for low-quality NEAT.
# PEM_NEAT_OPENAI_FALLBACK_MODEL=
# Optional per-stage max output tokens override (defaults are large stage-specific budgets).
# PEM_NEAT_MAX_OUTPUT_TOKENS=24000
BAXTER_ANTHROPIC_MODEL=claude-3-5-haiku-latest
# Optional OpenAI model-level fallback for temporary rate limits (not quota/billing).
BAXTER_OPENAI_FALLBACK_MODEL=
BAXTER_EMBEDDING_PROVIDER=openai
BAXTER_EMBEDDING_MODEL=text-embedding-3-small
BAXTER_VISION_PROVIDER=openai
BAXTER_VISION_MODEL=gpt-4o-mini

# Google Workspace connector (Prompt 2 — prefer Workspace OAuth)
# Production default: connect as baxter@actonadu.com via OAuth.
# The Cloud service account is external to Acton ADU and usually cannot join Shared Drives
# restricted to internal Workspace members.
GOOGLE_AUTH_MODE=workspace_oauth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://acton-baxter.vercel.app/api/admin/connectors/google/oauth/callback
GOOGLE_OAUTH_ALLOWED_DOMAINS=actonadu.com
GOOGLE_OAUTH_ALLOWED_EMAILS=baxter@actonadu.com
# 32-byte key as base64, or any passphrase (hashed with SHA-256). Server-only.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Optional service-account fallback (My Drive shares / orgs that allow SA access)
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER=
# Optional domain-wide delegation (only enable when Workspace admin fully configured DWD)
GOOGLE_IMPERSONATED_USER=

# Scheduled google_knowledge_sync via /api/internal/process-jobs (Vercel cron).
GOOGLE_SYNC_ENABLED=true
GOOGLE_SYNC_INTERVAL_MINUTES=180

# Knowledge document uploads (Prompt 1 Knowledge Management Rework)
KNOWLEDGE_UPLOAD_MAX_MB=20
# Optional parsing limits (sensible defaults apply if unset)
KNOWLEDGE_IMPORT_MAX_CHARACTERS=200000
KNOWLEDGE_IMPORT_MAX_ROWS=500
KNOWLEDGE_IMPORT_MAX_SHEETS=10

# Public app URL (used for Knowledge Base source links in Slack and elsewhere)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Slack (Prompt 5B — required when ENABLE_SLACK_INTEGRATION=true)
ENABLE_SLACK_INTEGRATION=false
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
# Unused when Socket Mode is disabled (default). Only set if socket_mode_enabled: true in the manifest.
SLACK_APP_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_COMMAND_NAME=/property
SLACK_ALLOWED_TEAM_IDS=
# Leave blank or unset to allow all channels Baxter belongs to.
# Add comma-separated Slack channel IDs to restrict Baxter to specific channels.
SLACK_ALLOWED_CHANNEL_IDS=
SLACK_ALLOWED_USER_IDS=
SLACK_ENABLE_DMS=true
# Set false to disable all channel @mentions (DMs unaffected when SLACK_ENABLE_DMS=true).
SLACK_ENABLE_CHANNEL_MENTIONS=true
# Optional — /property report ownership only. If unset, first admin profile is used.
# Not required for Slack Q&A (no fake Supabase users needed).
SLACK_REPORT_USER_ID=

# Slack Search — live Real-time Search + public channel history (no message mirror in Supabase)
# Requires migration 029 + Slack app reinstall with search scopes (see docs/slack-setup.md).
# If unset, inherits ENABLE_SLACK_INTEGRATION. Set explicitly to false to disable search while keeping Slack Q&A.
ENABLE_SLACK_SEARCH=true
# Optional admin sandbox public-only user token (xoxp-). Never used for other employees' private/DM data.
SLACK_SEARCH_USER_TOKEN=
# Defaults to ${APP_BASE_URL}/api/slack/search/oauth/callback
SLACK_SEARCH_OAUTH_REDIRECT_URI=
# Optional dedicated encryption key; otherwise reuses GHL_TOKEN_ENCRYPTION_KEY or GOOGLE_TOKEN_ENCRYPTION_KEY
SLACK_TOKEN_ENCRYPTION_KEY=

# Vercel Cron auth for /api/internal/process-jobs
# Prefer CRON_SECRET (Vercel sends Authorization: Bearer ${CRON_SECRET}).
CRON_SECRET=
# Deprecated compatibility alias — used only when CRON_SECRET is unset.
INTERNAL_CRON_SECRET=

# ============================================================================
# GoHighLevel CRM (Prompt 2 — read/write CRM access for Baxter)
# ============================================================================

# ---- Private Integration Mode (Recommended for Acton) ----
# This is the primary mode for single-location setups like Acton ADU.
# The Private Integration Token (PIT) is set here in Vercel env vars.
# Do NOT paste the token into the browser admin form.
#
# REQUIRED for PIT mode:
#   - ENABLE_GHL_INTEGRATION=true
#   - GHL_AUTH_MODE=private_integration
#   - GHL_PRIVATE_INTEGRATION_TOKEN=<your-pit-token>
#   - GHL_LOCATION_ID=<your-location-id>
#
# NOT required for PIT mode (only for OAuth):
#   - GHL_CLIENT_ID, GHL_CLIENT_SECRET, GHL_REDIRECT_URI
#
# PIT Scopes: Your Private Integration should have these scopes:
#   Core (required): contacts.readonly, opportunities.readonly, pipelines.readonly, users.readonly
#   Write (Prompt 2): contacts.write, opportunities.write, locations/customFields.write
#   Optional: calendars.readonly, calendars/events.readonly, conversations.readonly,
#             conversations/message.readonly, locations/customFields.readonly,
#             locations/tags.readonly, phonenumbers.read
#
# NOTE: locations.readonly is OPTIONAL. If your PIT doesn't have it, Baxter can still
# access contacts, opportunities, and pipelines. Location name enrichment will be skipped.

ENABLE_GHL_INTEGRATION=false
GHL_AUTH_MODE=private_integration
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
GHL_API_BASE_URL=https://services.leadconnectorhq.com

# ---- OAuth Mode (Marketplace-style apps / multi-tenant) ----
# Use this for apps that need to connect to multiple GHL locations.
# Requires OAuth app registration in GHL Marketplace.
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=https://acton-baxter.vercel.app/api/admin/connectors/ghl/oauth/callback
# Optional; falls back to GOOGLE_TOKEN_ENCRYPTION_KEY for OAuth token encryption
GHL_TOKEN_ENCRYPTION_KEY=

# ---- Optional Settings ----
# Override expected scopes (comma-separated). Leave blank for defaults.
GHL_EXPECTED_SCOPES=

# ---- Write Operations (Prompt 2) ----
# Enable GHL write operations for salespeople (admins always have write access when enabled)
ENABLE_GHL_WRITES_FOR_SALES=false

# Testing
RUN_LIVE_INTEGRATION_TESTS=false
E2E_TEST_AUTH_BYPASS=false
E2E_TEST_USER_ID=
E2E_TEST_USER_EMAIL=test@actonadu.local
E2E_TEST_USER_NAME=Test Salesperson
E2E_TEST_USER_ROLE=user
