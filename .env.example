# Core
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APP_BASE_URL=http://localhost:3000

# Research mode
ENABLE_MOCK_RESEARCH=true
ALLOW_MOCK_FALLBACK=false
ATTOM_API_KEY=
RENTCAST_API_KEY=
ATTOM_BASE_URL=https://api.gateway.attomdata.com/propertyapi/v1.0.0
RENTCAST_BASE_URL=https://api.rentcast.io/v1
EXTERNAL_API_TIMEOUT_MS=12000
EXTERNAL_API_MAX_RETRIES=2

# Address autocomplete + report imagery (recommended for production)
# Enable Places, Geocoding, Maps Static, and Street View Static APIs.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
# Legacy alias still accepted:
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# AI report generation
AI_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Baxter web chat (Prompt 3)
BAXTER_CHAT_ENABLED=true
BAXTER_LLM_PROVIDER=openai
BAXTER_OPENAI_MODEL=gpt-4o-mini
# Anthropic for Baxter is planned later — do not set BAXTER_LLM_PROVIDER=anthropic yet.

# Google Workspace connector (Prompt 4) — service account for baxter@actonadu.com / SA email
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER=

# Public app URL (used for Knowledge Base source links in Slack and elsewhere)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Slack (Prompt 5B — required when ENABLE_SLACK_INTEGRATION=true)
ENABLE_SLACK_INTEGRATION=false
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_COMMAND_NAME=/property
SLACK_ALLOWED_TEAM_IDS=
SLACK_ALLOWED_CHANNEL_IDS=
SLACK_ALLOWED_USER_IDS=
SLACK_ENABLE_DMS=true
SLACK_ENABLE_CHANNEL_MENTIONS=true
SLACK_REPORT_USER_ID=

# Internal job processor (Vercel cron)
INTERNAL_CRON_SECRET=

# Testing
RUN_LIVE_INTEGRATION_TESTS=false
E2E_TEST_AUTH_BYPASS=false
E2E_TEST_USER_ID=
E2E_TEST_USER_EMAIL=test@actonadu.local
E2E_TEST_USER_NAME=Test Salesperson
E2E_TEST_USER_ROLE=salesperson
